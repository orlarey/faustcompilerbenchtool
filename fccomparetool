#!/bin/bash

CXX=${CXX:-clang++}
SHARE=/usr/local/share/fctool

# The toolkit's version, answered by fcversion beside us or on the PATH.
case ${1:-} in
    --version) "$(dirname "$0")/fcversion" "$0" 2>/dev/null || fcversion "$0"; exit $? ;;
esac

# check if the user has provided the right number of arguments
if [ $# -ne 2 ]; then
	echo "Usage: fccomparetool <cppfile1> <cppfile2>"
	exit 1
fi

fcplottool $1
fcplottool $2

./${1%.cpp} > ${1%.cpp}.ir
./${2%.cpp} > ${2%.cpp}.ir

diff --suppress-common-lines -y ${1%.cpp}.ir ${2%.cpp}.ir

