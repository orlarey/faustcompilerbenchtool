#!/bin/bash

# fcspilltool — extract LLVM register-allocator metrics from compiling
# a Faust-generated C++ file, focused on the DSP compute() loop.
#
# Uses clang's -fsave-optimization-record (works with any clang —
# release builds included; no need for an asserts-enabled clang).
# Parses the resulting YAML to extract spill+reload copies and stack
# frame size.
#
# Crucially, results are filtered to the DSP audio loop. The full
# translation unit also includes the plotarch harness, the STL string
# machinery, etc., whose spills dwarf those of the DSP itself
# (typically 90+ vs 3) and would mask the signal of fusion
# experiments. Use the `--all` flag to get the unfiltered totals.
#
# Output format (key: value, one per line):
#
#   compute_spills:      N  # VR copies at function level in compute()
#   compute_outer_spills:O  # VR copies charged to the outer
#                           #   orchestration loop — `vindex` in -vec
#                           #   mode, the `index += 32` block loop in
#                           #   ocpp (0 only in plain scalar cpp, which
#                           #   has neither)
#   compute_inner_spills:I  # VR copies charged to the inner
#                           #   vectorizable loops — the hot path
#   compute_inner_max:   M  # worst single inner loop: the number that
#                           #   answers "does any one loop overflow the
#                           #   register bank?" — a question about the
#                           #   code, NOT a predictor of runtime (below)
#   compute_inner_count: K  # how many inner loop records contributed
#   compute_loop_spills: L  # O + I (kept for backwards compatibility)
#   compute_cost:        C  # LLVM's estimate of their cycle cost
#   compute_stack:       B  # stack frame bytes of compute() — direct
#                           #   proxy for intermediate-vector materialisation
#   all_spills:          T  # whole translation unit (incl. STL/harness)
#   all_stack:           A
#   total:               N  # alias of compute_spills
#   judge:               J  # the compiler that produced the numbers above:
#                           #   resolved path of $CXX and its version line.
#                           #   Spill counts are a property of the register
#                           #   allocator, not of the source: the same body
#                           #   gave englishBell 49 under clang 22.1.8 and
#                           #   66 under Apple clang 21 (and the ranking of
#                           #   -ss variants changed with it). A count read
#                           #   without its judge is not comparable to any
#                           #   other. Not emitted in --per-loop mode, whose
#                           #   TSV must stay joinable.
#
# WHAT THESE NUMBERS MEAN — IMPORTANT
#
# `compute_spills` is the function-level NumVRCopies LLVM emits for
# the spill/reload subsystem. It is NOT a direct count of stack
# accesses; it counts virtual-register COPY instructions inserted
# *around* spill/reload activity. As a proxy it scales with real
# pressure, but absolute numbers are not directly interpretable.
#
# BEWARE OF SUMS. `compute_loop_spills` and `compute_inner_spills`
# are sums over loop records, so they scale with the NUMBER of loops,
# not with per-loop pressure. A -vec program with 200 inner loops
# spilling 2 copies each reports 400 — which says nothing about any
# loop being under pressure. To answer "does a loop overflow the
# register bank?", read `compute_inner_max`, not the sums.
#
# Measured on the Faust example suite (clang 22), the outer `vindex`
# loop alone accounts for 26–100 % of loop-level spill copies, while
# `compute_inner_max` stays in the 0–10 range for most programs. The
# pressure lives in the orchestration of intermediate vectors, not in
# the vectorizable loops themselves.
#
# `compute_spills` also scales with function SIZE: comparing compute()
# between scalar and -vec modes is misleading because -vec inlines
# many small loops into one big compute(). For mode-to-mode comparison
# prefer `compute_inner_max` (per-loop pressure) and `compute_stack`
# (direct byte count of local materialisations).
#
# NONE OF THESE PREDICT RUNTIME, EXCEPT compute_stack. Measured twice,
# on two corpora, same judge:
#
#   - 81 filter matrices (m11..m99, ocpp), timings against every metric
#     with program size controlled for: only compute_stack survives
#     (partial r = +0.50, p = 2e-6); every spill-copy count sits at
#     |r| < 0.12.
#   - 6 programs x 5 emission variants at constant arithmetic. Where
#     only the ORDER of the statements changes (-ss), compute_inner_max
#     agrees with the timings' direction 52 % of the time — a coin
#     flip — while the timings themselves spread by 117 to 208 % at a
#     noise floor of 0.04 %. Where the LOOP STRUCTURE changes (-ls and
#     its fusions), compute_inner_max is *anti*-correlated (r = -0.53,
#     p = 0.01): bare -ls splits into 55 or 99 tiny loops, drops
#     compute_inner_max to 2, and is the slowest variant of all, having
#     traded register pressure for materialised intermediates.
#     compute_stack tracks that trade (r = +0.67, p < 0.001).
#
# So compute_inner_max answers what it says — per-loop pressure, and it
# is right that bare -ls relieves the bank — but per-loop pressure is
# not what governs time once the number of loops varies. Read it to
# understand a body, read compute_stack to guess whether it will be
# slow, and measure with fcmultibench to know.
#
# Requires clang. Refuses gcc with a clear message.

set -e

CXX=${CXX:-clang++}
SHARE=/usr/local/share/fctool
MODE=compute          # 'compute' (default) | 'all' | 'perloop'
CLASS=mydsp           # the Faust-generated DSP class (-cn changes it)

usage() {
    cat >&2 <<EOF
Usage: fcspilltool [--class NAME] [--all | --per-loop] <cppfile>

Options:
  --class NAME   DSP class name to filter on (default: mydsp, matches
                 the Faust default; set this if you used -cn).
  --all          Report only the unfiltered totals (no DSP filter).
  --per-loop     Instead of aggregating, emit one TSV row per compute()
                 loop record: line (in the ORIGINAL cpp file), kind
                 (outer|inner), spills (NumVRCopies), cost. Lets a
                 caller join measured pressure back to per-loop source
                 annotations (e.g. Faust -ls '// loop:' comments).
EOF
}

# ----------------------------------------------------------------------
# CLI
# ----------------------------------------------------------------------

while [ $# -gt 0 ]; do
    case "$1" in
        --class)  CLASS=$2; shift 2 ;;
        --all)    MODE=all; shift ;;
        --per-loop) MODE=perloop; shift ;;
        -h|--help) usage; exit 0 ;;
        -*)       echo "fcspilltool: unknown option '$1'" >&2; usage; exit 1 ;;
        *)        break ;;
    esac
done

if [ $# -ne 1 ]; then
    usage
    exit 1
fi

# ----------------------------------------------------------------------
# Clang gate
# ----------------------------------------------------------------------

if ! "$CXX" --version 2>/dev/null | grep -qi 'clang'; then
    cat >&2 <<EOF
fcspilltool: $CXX does not appear to be clang.

This tool relies on clang's '-fsave-optimization-record' to extract
register-allocator information. GCC has no comparable mechanism in a
portable YAML format.

To use fcspilltool, set CXX to a clang-based compiler:

    CXX=clang++ fcspilltool foo.cpp
EOF
    exit 2
fi

# The judge, named once and printed last: which binary $CXX resolved to,
# and what it says it is. After a session's PATH silently changed,
# `clang++` meant a different compiler and every count moved.
JUDGE="$(command -v "$CXX") $("$CXX" --version 2>/dev/null | head -1)"

# ----------------------------------------------------------------------
# Wrap and compile
# ----------------------------------------------------------------------

NAME=${1%.cpp}
TMPDIR_RUN=$(mktemp -d -t fcspill.XXXXXX)
trap 'rm -rf "$TMPDIR_RUN" "$NAME.tmp.cpp"' EXIT

# Same wrap as fcasmtool / fcbenchtool: plotarch header/footer template.
cat $SHARE/plotarch_header.cpp  > $NAME.tmp.cpp
cat $1                         >> $NAME.tmp.cpp
cat $SHARE/plotarch_footer.cpp >> $NAME.tmp.cpp

RECORD="$TMPDIR_RUN/record.yaml"

# Lines of the outer orchestration loops, if any. Faust emits one such
# loop wrapping the actual compute loops, and its shape depends on the
# backend:
#
#   -vec mode : for (vindex = 0; vindex <= (count - N); vindex += N)
#   ocpp mode : for (int index = 0; index < fullcount; index += 32)
#
# Both hold the pointers to every intermediate buffer, so they carry
# orchestration pressure rather than hot-path pressure and must not be
# charged to the inner bucket. Missing the ocpp form is not a rounding
# error: on a 9-tile program the block loop alone reports 219 copies
# against 26 for the worst inner loop, so it would swamp
# compute_inner_max entirely.
#
# Plain scalar `cpp` has neither form, in which case OUTER_LINES stays
# empty and every loop record counts as inner.
OUTER_LINES=$(grep -nE 'for \(vindex|for \(int index = 0; index < fullcount' \
                   "$NAME.tmp.cpp" | cut -d: -f1 | paste -sd, -)
OUTER_LINES=${OUTER_LINES:-}

# Offset to translate wrapped-file lines back to the original cpp
# (the plotarch header is prepended verbatim above the user file).
HDRLINES=$(wc -l < "$SHARE/plotarch_header.cpp" | tr -d ' ')

set +e
"$CXX" -O3 -ffast-math -march=native -fbracket-depth=1024 \
        -c -o /dev/null \
        -fsave-optimization-record \
        -foptimization-record-file="$RECORD" \
        "$NAME.tmp.cpp" 2> "$TMPDIR_RUN/diag.txt"
RC=$?
set -e

if [ $RC -ne 0 ]; then
    cat "$TMPDIR_RUN/diag.txt" >&2
    exit $RC
fi

if [ ! -s "$RECORD" ]; then
    echo "fcspilltool: optimization record empty or missing ($RECORD)" >&2
    exit 3
fi

# ----------------------------------------------------------------------
# Parse the YAML record
# ----------------------------------------------------------------------
# Record shape:
#
#   --- !Missed
#   Pass:            regalloc
#   Name:            SpillReloadCopies          (function-level)
#                 or LoopSpillReloadCopies      (loop-level subset)
#   Function:        _ZN5mydsp7computeEiPPfS1_  (Itanium-mangled)
#   ...
#   Args:
#     - NumVRCopies:     '3'
#     - String:          ' virtual registers copies '
#     - TotalCopiesCost: '6.000000e+01'
#     ...
#   ...
#
# Function names are mangled. We identify compute() via the substring
# "<len><CLASS><len>computeE" (Itanium ABI: length-prefixed segments,
# E ends the nested-name qualifier). For Faust's default class "mydsp"
# this gives "5mydsp7computeE", which is highly specific.

CLASS_LEN=${#CLASS}
COMPUTE_PATTERN="${CLASS_LEN}${CLASS}7computeE"

AWK_SCRIPT="$TMPDIR_RUN/parse.awk"
cat > "$AWK_SCRIPT" <<'AWK_EOF'
BEGIN {
    compute_pat = COMPUTE_PAT
    n_outer = split(OUTER_LINES, _ol, ",")
    for (k = 1; k <= n_outer; k++) if (_ol[k] != "") outer[_ol[k] + 0] = 1
}

function value(line) {
    gsub(/[[:space:]'\'']/, "", line)
    sub(/^.*:/, "", line)
    return line
}

/^--- !/ {
    in_rec=1; pass=""; name=""; fn=""; line=0
    numvr=0; cost=0; stackb=0
    next
}

in_rec && /^Pass:/             { pass = $2 }
in_rec && /^Name:/             { name = $2 }
in_rec && /^Function:/         { fn   = $2 }
in_rec && /^DebugLoc:/ {
    l = $0
    sub(/.*Line:[[:space:]]*/, "", l)
    sub(/,.*/, "", l)
    line = l + 0
}
in_rec && /NumVRCopies:/       { numvr  = value($0) + 0 }
in_rec && /TotalCopiesCost:/   { cost   = value($0) + 0 }
in_rec && /NumStackBytes:/     { stackb = value($0) + 0 }

/^\.\.\./ {
    if (in_rec) {
        is_compute = (index(fn, compute_pat) > 0)

        if (pass == "regalloc" && name == "SpillReloadCopies") {
            all_spills += numvr
            all_cost   += cost
            if (is_compute) {
                compute_spills += numvr
                compute_cost   += cost
            }
        }
        if (pass == "regalloc" && name == "LoopSpillReloadCopies" && is_compute) {
            if (PERLOOP) {
                printf "%d\t%s\t%d\t%d\n", line - HDRLINES,
                       ((line + 0) in outer) ? "outer" : "inner", numvr, cost
            }
            compute_loop_spills += numvr
            # The outer loop is the orchestrator: it holds the pointers
            # to every intermediate buffer. Charging it to the same
            # bucket as the inner compute loops would conflate
            # orchestration pressure with hot-path pressure.
            if ((line + 0) in outer) {
                compute_outer_spills += numvr
            } else {
                compute_inner_spills += numvr
                compute_inner_count++
                if (numvr > compute_inner_max) compute_inner_max = numvr
            }
        }
        if (pass == "prologepilog" && name == "StackSize") {
            all_stack += stackb
            if (is_compute) compute_stack += stackb
        }
        in_rec = 0
    }
}

END {
    if (PERLOOP) exit
    printf "compute_spills:       %d\n", compute_spills + 0
    printf "compute_outer_spills: %d\n", compute_outer_spills + 0
    printf "compute_inner_spills: %d\n", compute_inner_spills + 0
    printf "compute_inner_max:    %d\n", compute_inner_max + 0
    printf "compute_inner_count:  %d\n", compute_inner_count + 0
    printf "compute_loop_spills:  %d\n", compute_loop_spills + 0
    printf "compute_cost:         %d\n", compute_cost + 0
    printf "compute_stack:        %d\n", compute_stack + 0
    printf "all_spills:           %d\n", all_spills + 0
    printf "all_stack:            %d\n", all_stack + 0
    printf "total:                %d\n", compute_spills + 0
}
AWK_EOF

if [ "$MODE" = all ]; then
    awk -v COMPUTE_PAT="$COMPUTE_PATTERN" -v OUTER_LINES="$OUTER_LINES" \
        -v PERLOOP=0 -v HDRLINES="$HDRLINES" \
        -f "$AWK_SCRIPT" "$RECORD" | grep -E '^(all_[a-z]+|total):'
    printf 'judge:                %s\n' "$JUDGE"
elif [ "$MODE" = perloop ]; then
    printf 'line\tkind\tspills\tcost\n'
    awk -v COMPUTE_PAT="$COMPUTE_PATTERN" -v OUTER_LINES="$OUTER_LINES" \
        -v PERLOOP=1 -v HDRLINES="$HDRLINES" \
        -f "$AWK_SCRIPT" "$RECORD" | sort -n
else
    awk -v COMPUTE_PAT="$COMPUTE_PATTERN" -v OUTER_LINES="$OUTER_LINES" \
        -v PERLOOP=0 -v HDRLINES="$HDRLINES" \
        -f "$AWK_SCRIPT" "$RECORD"
    printf 'judge:                %s\n' "$JUDGE"
fi
